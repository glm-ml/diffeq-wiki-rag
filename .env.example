# Ключ DeepSeek: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Модель: deepseek-chat (быстрая) или deepseek-reasoner (с рассуждением)
LLM_MODEL=deepseek-chat

# Пусто -> встроенный Qdrant в папке qdrant_data.
# В docker-compose переопределяется на http://qdrant:6333
QDRANT_URL=

# Веб-поиск как третий инструмент агента
ENABLE_WEB_SEARCH=true

# HTTPS: nip.io бесплатно резолвит IP в домен.
# Для своего домена замените DOMAIN и укажите e-mail для Let's Encrypt.
DOMAIN=195.62.49.192.nip.io
LETSENCRYPT_EMAIL=you@example.com
PUBLIC_BASE_URL=https://195.62.49.192.nip.io
